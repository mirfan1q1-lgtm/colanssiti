---
import Layout from '../../layouts/Layout.astro';
import PartnerLoginForm from '../../components/PartnerLoginForm';
import { getSessionFromRequest } from '../../lib/auth';
import { getCfEnv } from '../../lib/cfEnv';

export const prerender = false;

const env = getCfEnv();
const session = getSessionFromRequest(Astro.request, env?.SESSION_SECRET || process.env.SESSION_SECRET || '');
const redirectParam = Astro.url.searchParams.get('redirect');
const safeRedirect = redirectParam && /^\/kelola\/[a-z0-9-]+$/i.test(redirectParam) ? redirectParam : undefined;
if (session?.slug) return Astro.redirect(`/kelola/${session.slug}`);
---

<Layout title="Masuk Portal Mitra — Sekarsiti" description="Masuk untuk mengelola profil dan layanan mitra Sekarsiti Wedding Studio.">
  <div class="min-h-screen flex flex-col justify-between bg-[#FDFBF7]">
    <!-- Minimal Clean Header -->
    <header class="border-b border-stone-200/70 bg-white/80 backdrop-blur-sm sticky top-0 z-30">
      <div class="max-w-5xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group" aria-label="Sekarsiti Wedding Studio">
          <span class="w-8 h-8 rounded-full bg-stone-900 text-stone-100 flex items-center justify-center font-serif text-base font-bold transition group-hover:scale-105">S</span>
          <span class="font-serif font-bold text-stone-900 text-lg leading-none tracking-tight">Sekarsiti</span>
        </a>
        <a href="/mitra" class="text-xs font-medium text-stone-600 hover:text-stone-900 transition flex items-center gap-1">
          <span>Direktori Publik</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <!-- Main Login Card Area -->
    <main class="flex-1 flex items-center justify-center px-4 py-12 sm:py-16">
      <div class="w-full max-w-md">
        <!-- Brand Badge & Header -->
        <div class="text-center mb-8">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-stone-100 border border-stone-200/80 text-[11px] font-semibold text-stone-700 tracking-wide uppercase">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Portal Mitra Mandiri
          </span>
          <h1 class="mt-3 font-serif text-3xl sm:text-4xl font-bold text-stone-900 tracking-tight">
            Masuk ke Akun
          </h1>
          <p class="mt-2 text-xs sm:text-sm text-stone-500 max-w-xs mx-auto leading-relaxed">
            Perbarui tarif paket, kontak booking, dan kelola portofolio landing page Anda.
          </p>
        </div>

        <!-- Card Container -->
        <div class="bg-white border border-stone-200/90 rounded-2xl sm:rounded-3xl p-6 sm:p-9 shadow-sm">
          <PartnerLoginForm client:load initialRedirect={safeRedirect} />
        </div>

        <!-- Help Link -->
        <div class="mt-6 text-center text-xs text-stone-400">
          Butuh bantuan akses? <a href="https://wa.me/6281294891838" target="_blank" rel="noopener" class="text-stone-600 hover:text-stone-900 underline underline-offset-2">Hubungi Admin Sekarsiti</a>
        </div>
      </div>
    </main>

    <!-- Clean Minimal Footer -->
    <footer class="border-t border-stone-200/60 bg-white/50 py-4 text-center text-xs text-stone-400">
      <span>© 2026 Sekarsiti Wedding Studio · Sistem Portal Mitra</span>
    </footer>
  </div>
</Layout>
