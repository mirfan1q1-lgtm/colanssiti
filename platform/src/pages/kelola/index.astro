---
import Layout from '../../layouts/Layout.astro';
import { getAllPartners } from '../../lib/partners';
import { getSessionFromRequest } from '../../lib/auth';
import { getCfEnv } from '../../lib/cfEnv';

export const prerender = false;

const env = getCfEnv();
const session = getSessionFromRequest(Astro.request, env?.SESSION_SECRET || process.env.SESSION_SECRET || '');
if (session?.slug) return Astro.redirect(`/kelola/${session.slug}`);

const partners = await getAllPartners(env);
---

<Layout
  title="Portal Mitra — Sekarsiti Wedding Studio"
  description="Kelola profil, paket layanan, dan informasi booking Anda di portal mitra Sekarsiti."
>
  <div class="h-1 bg-gradient-to-r from-atelier-700 via-atelier-400 to-atelier-700"></div>
  <header class="border-b border-atelier-200 bg-white">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 h-[76px] flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group" aria-label="Sekarsiti, halaman utama">
        <span class="w-10 h-10 rounded-full bg-atelier-800 text-atelier-100 flex items-center justify-center font-serif text-xl font-bold">S</span>
        <span>
          <span class="block font-serif font-bold text-stone-900 text-xl leading-none">Sekarsiti</span>
          <span class="block mt-1 text-[10px] uppercase tracking-[.19em] text-atelier-700 font-semibold">Portal Kemitraan</span>
        </span>
      </a>
      <a href="/mitra" class="text-sm font-semibold text-stone-600 hover:text-atelier-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-atelier-700 transition">
        Lihat direktori mitra <span aria-hidden="true">↗</span>
      </a>
    </div>
  </header>

  <main class="flex-1">
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,_var(--tw-gradient-stops))] from-atelier-200/55 via-atelier-50 to-atelier-50"></div>
      <div class="relative max-w-6xl mx-auto px-5 sm:px-8 pt-12 sm:pt-20 pb-14 sm:pb-20">
        <div class="grid lg:grid-cols-[1.25fr_.75fr] gap-10 lg:gap-16 items-center">
          <div class="max-w-2xl">
            <span class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[.2em] font-bold text-atelier-800">
              <span class="w-7 h-px bg-atelier-500"></span> Untuk partner Sekarsiti
            </span>
            <h1 class="mt-5 font-serif text-5xl sm:text-6xl lg:text-7xl leading-[.98] tracking-tight text-stone-900">
              Profil Anda,<br /><em class="font-normal text-atelier-700">selalu siap.</em>
            </h1>
            <p class="mt-6 text-base sm:text-lg leading-8 text-stone-600 max-w-xl">
              Perbarui paket, kontak booking, dan cerita layanan Anda dari satu tempat. Perubahan yang Anda simpan akan tampil di halaman mitra.
            </p>
            <div class="mt-8 flex flex-col sm:flex-row gap-3">
              <a href="/kelola/login" class="inline-flex min-h-12 items-center justify-center gap-3 px-6 rounded-xl bg-atelier-800 hover:bg-atelier-900 text-white font-semibold text-sm shadow-lg shadow-atelier-900/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-atelier-800 transition">
                Masuk ke portal <span aria-hidden="true">→</span>
              </a>
              <a href="#langkah" class="inline-flex min-h-12 items-center justify-center px-5 rounded-xl text-stone-700 hover:bg-white/70 font-semibold text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-atelier-700 transition">
                Cara menggunakan
              </a>
            </div>
            <p class="mt-4 text-xs text-stone-500">Gunakan nomor WhatsApp terdaftar (atau slug profil) dan kata sandi Anda.</p>
          </div>

          <aside class="relative lg:ml-auto w-full max-w-md" aria-label="Ringkasan portal">
            <div class="relative bg-stone-900 text-white p-7 sm:p-9 rounded-2xl shadow-xl border border-stone-800">
              <div class="flex items-center justify-between">
                <span class="uppercase tracking-[.18em] text-[10px] text-stone-400 font-bold">Ruang Kerja Mandiri</span>
                <span class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-stone-300 text-sm">✦</span>
              </div>
              <p class="mt-8 font-serif text-3xl sm:text-4xl leading-tight">Semua data penting, langsung dalam kendali Anda.</p>
              <div class="mt-8 border-t border-white/10 pt-6 grid grid-cols-2 gap-4">
                <div><p class="text-xl font-serif text-stone-200">01</p><p class="mt-1 text-xs text-stone-400">Pembaruan harga paket</p></div>
                <div><p class="text-xl font-serif text-stone-200">02</p><p class="mt-1 text-xs text-stone-400">Kontak booking WhatsApp</p></div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section id="langkah" class="bg-white border-y border-stone-200/80">
      <div class="max-w-6xl mx-auto px-5 sm:px-8 py-8 sm:py-10">
        <div class="flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-10">
          <div class="sm:w-48 shrink-0">
            <p class="text-[10px] uppercase tracking-[.18em] text-stone-500 font-bold">Mulai dalam 3 langkah</p>
            <p class="mt-1 font-serif text-2xl text-stone-900">Cepat & Mandiri</p>
          </div>
          <ol class="grid sm:grid-cols-3 gap-5 sm:gap-7 w-full">
            <li class="flex gap-3"><span class="text-stone-400 font-serif text-xl font-bold">01</span><span class="text-xs sm:text-sm leading-6 text-stone-600"><strong class="text-stone-900 block font-semibold">Masuk Akun</strong>Gunakan WhatsApp & kata sandi Anda.</span></li>
            <li class="flex gap-3"><span class="text-stone-400 font-serif text-xl font-bold">02</span><span class="text-xs sm:text-sm leading-6 text-stone-600"><strong class="text-stone-900 block font-semibold">Perbarui Layanan</strong>Ubah harga paket, nomor kontak & bio.</span></li>
            <li class="flex gap-3"><span class="text-stone-400 font-serif text-xl font-bold">03</span><span class="text-xs sm:text-sm leading-6 text-stone-600"><strong class="text-stone-900 block font-semibold">Simpan Perubahan</strong>Langsung live seketika di halaman publik.</span></li>
          </ol>
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-5 sm:px-8 py-12 sm:py-16">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-7">
        <div>
          <p class="text-[10px] uppercase tracking-[.2em] text-stone-500 font-bold">Akses Cepat</p>
          <h2 class="mt-1 font-serif text-3xl sm:text-4xl text-stone-900">Pilih Profil Mitra</h2>
        </div>
        <p class="text-xs sm:text-sm text-stone-500">Masuk untuk mengelola dan memperbarui data profil Anda.</p>
      </div>

      {partners.length > 0 ? (
        <ul class="grid sm:grid-cols-2 gap-4">
          {partners.map((partner) => (
            <li>
              <a href={`/kelola/login?redirect=/kelola/${partner.slug}`} class="group flex items-center gap-4 p-4 sm:p-5 bg-white border border-atelier-200 rounded-2xl hover:border-atelier-500 hover:shadow-lg hover:shadow-atelier-900/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-atelier-700 transition">
                <span class="w-14 h-14 rounded-xl bg-atelier-100 border border-atelier-200 overflow-hidden shrink-0 flex items-center justify-center font-serif text-2xl text-atelier-800">
                  {partner.media?.[0]?.secureUrl ? <img src={partner.media[0].secureUrl} alt="" class="w-full h-full object-cover" loading="lazy" /> : partner.brandName.charAt(0)}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-semibold text-stone-900 group-hover:text-atelier-800 transition truncate">{partner.brandName}</span>
                  <span class="block mt-1 text-xs text-stone-500 truncate">{partner.category} · {partner.cityCoverage}</span>
                  <span class="block mt-2 text-[11px] text-atelier-700 font-medium">Masuk untuk mengelola <span aria-hidden="true">→</span></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="rounded-2xl border border-dashed border-atelier-300 bg-white/70 p-8 text-center">
          <p class="font-serif text-2xl text-stone-900">Profil mitra akan tampil di sini</p>
          <p class="mt-2 text-sm text-stone-600">Daftarkan layanan Anda untuk memulai kolaborasi.</p>
        </div>
      )}

      <div class="mt-8 p-5 sm:p-6 rounded-2xl bg-atelier-100/80 border border-atelier-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div><p class="font-semibold text-stone-900">Belum menjadi mitra Sekarsiti?</p><p class="mt-1 text-sm text-stone-600">Kenalkan layanan pernikahan Anda kepada calon pengantin.</p></div>
        <a href="/gabung" class="inline-flex min-h-11 items-center justify-center px-5 rounded-xl border border-atelier-400 text-atelier-900 hover:bg-white font-semibold text-sm transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-atelier-700">Daftar kolaborasi <span class="ml-2" aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>

  <footer class="border-t border-atelier-200 bg-white">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-5 flex flex-col sm:flex-row gap-2 justify-between text-xs text-stone-500">
      <span>© Sekarsiti Wedding Studio · Portal Mitra</span><a href="/mitra" class="hover:text-atelier-800">Jelajahi direktori publik</a>
    </div>
  </footer>
</Layout>
