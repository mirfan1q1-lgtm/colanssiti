---
import Layout from '../../layouts/Layout.astro';
import PartnerSelfServiceEditor from '../../components/PartnerSelfServiceEditor';
import { getPartnerBySlug } from '../../lib/partners';
import { getSessionFromRequest } from '../../lib/auth';
import { getCfEnv } from '../../lib/cfEnv';

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/kelola/login');
}

// 1. Verifikasi Auth Session dari HttpOnly Cookie
const env = getCfEnv();
const session = getSessionFromRequest(Astro.request, env?.SESSION_SECRET || process.env.SESSION_SECRET || '');

// Jika belum login atau sesi bukan milik slug yang diminta, arahkan ke login
if (!session || session.slug !== slug.toLowerCase().trim()) {
  return Astro.redirect(`/kelola/login?redirect=/kelola/${slug}`);
}

const partner = await getPartnerBySlug(slug, env);

if (!partner) {
  return new Response('Mitra tidak ditemukan. Periksa kembali tautan Anda.', {
    status: 404,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' },
  });
}
---

<Layout 
  title={`Kelola Profil & Layanan — ${partner.brandName}`} 
  description="Panel pengelolaan mandiri data mitra, paket harga, kontak WhatsApp, dan portofolio foto Sekarsiti Wedding Studio."
>
  <div class="min-h-screen flex flex-col justify-between bg-[#FDFBF7]">
    <!-- Top Accent Bar -->
    <div class="h-0.5 bg-gradient-to-r from-stone-400 via-amber-700 to-stone-400"></div>

    <!-- Clean Header Navigation -->
    <header class="bg-white/90 backdrop-blur-md border-b border-stone-200/80 sticky top-0 z-40">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/" class="w-8 h-8 rounded-full bg-stone-900 text-stone-100 flex items-center justify-center font-serif text-base font-bold transition hover:scale-105" aria-label="Sekarsiti Home">
            S
          </a>
          <div class="flex items-center gap-2.5">
            <span class="font-serif font-bold text-stone-900 text-base leading-none">
              {partner.brandName}
            </span>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-50 text-[10px] text-emerald-700 font-semibold border border-emerald-200/60">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Sesi Aktif
            </span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <a 
            href={`/mitra/${partner.slug}`} 
            target="_blank" 
            rel="noopener"
            class="h-9 px-3.5 rounded-xl border border-stone-200 hover:border-stone-400 text-stone-700 hover:text-stone-900 text-xs font-semibold transition flex items-center gap-1.5 bg-white shadow-2xs"
          >
            <span>Lihat Halaman</span>
            <svg class="w-3.5 h-3.5 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

          <!-- Logout Button -->
          <button
            id="logoutBtn"
            class="h-9 px-3 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-600 hover:text-stone-900 text-xs font-semibold transition cursor-pointer"
          >
            Keluar
          </button>
        </div>
      </div>
    </header>

    <!-- Main Body -->
    <main class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-8 w-full flex-1">
      <div class="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-3 pb-5 border-b border-stone-200/70">
        <div>
          <div class="flex items-center gap-2 text-xs text-stone-400 mb-1">
            <a href="/kelola" class="hover:text-stone-700 transition">Portal Mitra</a>
            <span>/</span>
            <span class="text-stone-700 font-medium">{partner.brandName}</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-stone-900 tracking-tight">
            Pengaturan Layanan & Profil
          </h2>
          <p class="text-xs sm:text-sm text-stone-500 mt-1">
            Kelola paket harga, nomor kontak WhatsApp, dan informasi tampilan profil publik Anda.
          </p>
        </div>
        
        <span class="text-[11px] text-stone-400 self-start sm:self-end">
          Kategori: <strong class="text-stone-700 font-medium">{partner.category}</strong>
        </span>
      </div>

      <!-- Client-side React Editor -->
      <PartnerSelfServiceEditor client:load partner={partner} />
    </main>

    <!-- Clean Footer -->
    <footer class="border-t border-stone-200/60 bg-white/50 py-4 text-center text-xs text-stone-400">
      <span>© 2026 Sekarsiti Wedding Studio · Ruang Kerja Mitra</span>
    </footer>
  </div>

  <script>
    const logoutBtn = document.getElementById('logoutBtn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', async () => {
        if (confirm('Apakah Anda yakin ingin keluar dari portal kelola?')) {
          await fetch('/api/auth/logout', { method: 'POST' });
          window.location.href = '/kelola/login';
        }
      });
    }
  </script>
</Layout>
