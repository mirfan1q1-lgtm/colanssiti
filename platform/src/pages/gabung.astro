---
import Layout from '../layouts/Layout.astro';
import OnboardingForm from '../components/OnboardingForm';
---

<Layout
  title="Formulir Kemitraan Vendor — Sekarsiti Wedding Studio"
  description="Daftarkan profil dan materi portofolio Anda untuk dibuatkan landing page profesional tanpa biaya jasa oleh Sekarsiti Wedding Studio."
>
  <!-- Top Announcement Bar -->
  <div class="bg-atelier-900 text-atelier-200 text-xs py-2 px-4 text-center font-medium border-b border-atelier-800">
    <span>✦ Program Kemitraan Terbuka 2026: Kolaborasi Landing Page Eksklusif Tanpa Biaya Jasa</span>
  </div>

  <!-- Header -->
  <header class="w-full border-b border-atelier-200/80 bg-white/90 backdrop-blur-md sticky top-0 z-40">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-atelier-100 border border-atelier-300 flex items-center justify-center text-atelier-800 font-serif font-bold text-lg">
          S
        </div>
        <div>
          <span class="font-serif font-bold text-xl text-stone-900 leading-none block">Sekarsiti</span>
          <span class="text-[10px] uppercase tracking-[0.2em] text-atelier-700 font-semibold">Atelier Undangan</span>
        </div>
      </a>
      <a
        href="/"
        class="text-xs font-semibold text-stone-600 hover:text-stone-900 transition flex items-center gap-1"
      >
        <span>← Kembali</span>
      </a>
    </div>
  </header>

  <!-- Hero Header -->
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="text-center max-w-2xl mx-auto mb-10 space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-atelier-100 border border-atelier-300 text-atelier-800 text-[11px] font-bold tracking-widest uppercase">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Onboarding Kemitraan Mandiri
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-stone-900 leading-tight">
        Formulir Materi Landing Page
      </h1>
      <p class="text-stone-600 text-xs sm:text-sm leading-relaxed">
        Lengkapi profil dan foto portofolio terbaik Anda. Foto kamera HP Anda akan otomatis dikompresi ke format WebP agar proses pengiriman kilat dan ringan.
      </p>
    </div>

    <!-- Interactive Form -->
    <OnboardingForm client:load />
  </main>

  <!-- Footer -->
  <footer class="text-center py-8 text-xs text-stone-500 border-t border-atelier-200 bg-white mt-16">
    <p>&copy; 2026 Sekarsiti Wedding Studio • Program Kemitraan Terbuka</p>
    <p class="mt-1 text-[11px] text-stone-400">Semua materi tersimpan aman dan terenkripsi</p>
  </footer>
</Layout>

